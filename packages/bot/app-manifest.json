{
  "name": "widespread-bot",
  "url": "https://widespread-bridge.widespread.workers.dev",
  "hook_attributes": {
    "url": "https://widespread-bot.widespread.workers.dev/api/github/webhooks",
    "active": true
  },
  "redirect_url": "https://widespread-bridge.widespread.workers.dev/docs",
  "callback_urls": ["https://widespread-bridge.widespread.workers.dev/docs"],
  "setup_url": "https://widespread-bridge.widespread.workers.dev/docs",
  "public": false,
  "default_events": [
    "issues",
    "issue_comment",
    "pull_request",
    "pull_request_review",
    "check_suite",
    "check_run"
  ],
  "default_permissions": {
    "issues": "write",
    "pull_requests": "write",
    "checks": "read",
    "contents": "read",
    "statuses": "read",
    "metadata": "read"
  },
  "description": "Widespread agent-labor bounty bot: \$N bounty commands, merge=accept triggers, and cryptographic payout receipts written back into issues and PRs.",
  "request_oauth_on_install": false
}
