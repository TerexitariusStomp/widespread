# Dependency lifecycle scripts are governed by `onlyBuiltDependencies` in
# pnpm-workspace.yaml (the pnpm-native location). These npmrc entries mirror
# the same allowlist for tools that read .npmrc directly.
only-built-dependencies[]=near-sdk-js
only-built-dependencies[]=esbuild
only-built-dependencies[]=workerd
only-built-dependencies[]=sharp
